{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ryjen.github.io/guitar-practice-system/contracts/backing-tracks/backing-track-request.schema.json",
  "title": "BackingTrackRequest",
  "description": "Bounded caller-facing request that resolves deterministically into a BackingTrackSpec.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "title",
    "purpose",
    "key_signature",
    "tempo_bpm",
    "meter",
    "groove_preset",
    "form",
    "instrumentation"
  ],
  "properties": {
    "version": {"const": 1},
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 500},
    "key_signature": {"type": "string", "minLength": 1, "maxLength": 16},
    "tempo_bpm": {"type": "integer", "minimum": 20, "maximum": 300},
    "meter": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 1},
        {"type": "integer", "enum": [1, 2, 4, 8, 16]}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "groove_preset": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "bass_style": {
      "type": "string",
      "enum": [
        "auto",
        "kick-root",
        "kick-root-fifth",
        "kick-root-octave",
        "walking"
      ],
      "default": "auto"
    },
    "count_in_bars": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4,
      "default": 1
    },
    "form": {"$ref": "#/$defs/form"},
    "instrumentation": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "contains": {"const": "drums"},
      "items": {
        "type": "string",
        "enum": ["drums", "bass", "keys", "pad"]
      }
    },
    "arrangement": {"$ref": "#/$defs/arrangement"}
  },
  "$defs": {
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bars"],
      "oneOf": [
        {
          "required": ["progression"],
          "not": {"required": ["progression_preset"]}
        },
        {
          "required": ["progression_preset"],
          "not": {"required": ["progression"]}
        }
      ],
      "properties": {
        "bars": {"type": "integer", "minimum": 1, "maximum": 128},
        "progression": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {"type": "string", "minLength": 1, "maxLength": 16}
        },
        "progression_preset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "section_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "default": "PRACTICE"
        }
      }
    },
    "arrangement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bar_cycle": {"$ref": "#/$defs/barCycle"}
      }
    },
    "barCycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length", "mute_bars"],
      "properties": {
        "length": {"type": "integer", "minimum": 1, "maximum": 64},
        "mute_bars": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 63}
        }
      }
    }
  }
}
