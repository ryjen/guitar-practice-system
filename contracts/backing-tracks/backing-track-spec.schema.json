{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ryjen.github.io/guitar-practice-system/contracts/backing-tracks/backing-track-spec.schema.json",
  "title": "BackingTrackSpec",
  "description": "Deterministic backing-track manifest with optional named groove preset and arrangement-wide bar cycle.",
  "type": "object",
  "required": [
    "id",
    "title",
    "key_signature",
    "tempo_bpm",
    "meter",
    "count_in_bars",
    "sections",
    "tracks",
    "outputs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "key_signature": {
      "type": "string",
      "minLength": 1
    },
    "tempo_bpm": {
      "type": "integer",
      "minimum": 20,
      "maximum": 300
    },
    "meter": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "integer",
          "enum": [1, 2, 4, 8, 16]
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "count_in_bars": {
      "type": "integer",
      "minimum": 0
    },
    "arrangement": {
      "$ref": "#/$defs/arrangement"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/track"
      }
    },
    "outputs": {
      "type": "object",
      "required": ["midi"],
      "properties": {
        "midi": {
          "type": "string",
          "pattern": "^generated/backing-tracks/.+\\.mid$"
        },
        "audio": {},
        "daw_project": {}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "barCycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length", "mute_bars"],
      "properties": {
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "mute_bars": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          }
        }
      }
    },
    "arrangement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bar_cycle": {
          "$ref": "#/$defs/barCycle"
        }
      }
    },
    "section": {
      "type": "object",
      "required": ["name", "bars", "chords"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "bars": {
          "type": "integer",
          "minimum": 1
        },
        "chords": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "track": {
      "type": "object",
      "required": ["name", "role", "channel"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "groove": {
          "$ref": "groove-spec.schema.json"
        },
        "groove_preset": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "not": {
        "required": ["groove", "groove_preset"]
      },
      "additionalProperties": true
    }
  }
}
