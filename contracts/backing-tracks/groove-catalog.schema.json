{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ryjen.github.io/guitar-practice-system/contracts/backing-tracks/groove-catalog.schema.json",
  "title": "GroovePresetCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "presets"],
  "properties": {
    "version": {"const": 1},
    "presets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/preset"}
    }
  },
  "$defs": {
    "preset": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "meter",
        "default_tempo_bpm",
        "tempo_range_bpm",
        "tags",
        "practice_intents",
        "groove"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "meter": {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 1},
            {"type": "integer", "enum": [1, 2, 4, 8, 16]}
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "default_tempo_bpm": {
          "type": "integer",
          "minimum": 20,
          "maximum": 300
        },
        "tempo_range_bpm": {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 20, "maximum": 300},
            {"type": "integer", "minimum": 20, "maximum": 300}
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "grouping": {"type": "string", "minLength": 1},
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "practice_intents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "groove": {"$ref": "groove-spec.schema.json"}
      },
      "additionalProperties": false
    }
  }
}
