{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ryjen/guitar-practice-system/contracts/scheduling/v1/scheduling.schema.json",
  "title": "Guitar Practice Scheduling Contract v1",
  "oneOf": [
    {"$ref": "#/$defs/snapshot"},
    {"$ref": "#/$defs/proposal"},
    {"$ref": "#/$defs/projectionReport"},
    {"$ref": "#/$defs/approval"},
    {"$ref": "#/$defs/completion"},
    {"$ref": "#/$defs/event"}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "date": {"type": "string", "format": "date"},
    "dateTime": {"type": "string", "format": "date-time"},
    "state": {
      "type": "string",
      "enum": ["candidate", "active", "verified", "maintenance", "paused", "retired"]
    },
    "realization": {"type": "object", "additionalProperties": true},
    "practiceGoal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "item_id", "period", "target_sessions", "completed_sessions"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "item_id": {"$ref": "#/$defs/id"},
        "period": {"type": "string", "enum": ["weekly", "monthly"]},
        "target_sessions": {"type": "integer", "minimum": 1, "maximum": 1000},
        "completed_sessions": {"type": "integer", "minimum": 0, "maximum": 1000}
      }
    },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "satisfied_states"],
      "properties": {
        "item_id": {"$ref": "#/$defs/id"},
        "satisfied_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/state"}
        }
      }
    },
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "priority", "target_minutes", "prerequisites"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "dimension": {"$ref": "#/$defs/id"},
        "state": {"$ref": "#/$defs/state"},
        "approved_transition_proposal_id": {"$ref": "#/$defs/id"},
        "priority": {"type": "integer", "minimum": 0, "maximum": 10000},
        "target_minutes": {"type": "integer", "minimum": 1, "maximum": 240},
        "target_realization": {"$ref": "#/$defs/realization"},
        "maintenance_realization": {"$ref": "#/$defs/realization"},
        "plateau_observed": {"type": "boolean"},
        "prerequisites": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/prerequisite"}
        },
        "maintenance_interval_days": {"type": "integer", "minimum": 1, "maximum": 3650},
        "last_verified_date": {"$ref": "#/$defs/date"},
        "last_practiced_at": {"$ref": "#/$defs/dateTime"},
        "min_recovery_hours": {"type": "integer", "minimum": 0, "maximum": 720},
        "weekly_count": {"type": "integer", "minimum": 0, "maximum": 100},
        "missed": {"type": "boolean"}
      }
    },
    "weeklyBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_sessions", "completed_sessions", "max_minutes", "completed_minutes", "max_same_target"],
      "properties": {
        "max_sessions": {"type": "integer", "minimum": 0, "maximum": 50},
        "completed_sessions": {"type": "integer", "minimum": 0, "maximum": 50},
        "max_minutes": {"type": "integer", "minimum": 0, "maximum": 10080},
        "completed_minutes": {"type": "integer", "minimum": 0, "maximum": 10080},
        "max_same_target": {"type": "integer", "minimum": 1, "maximum": 50}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type", "contract_version", "snapshot_id", "state_revision", "ruleset_version",
        "generated_at", "effective_date", "timezone", "session_minutes", "minimum_block_minutes",
        "max_active_items", "self_reported_load", "high_load_max_minutes", "weekly_budget", "items"
      ],
      "properties": {
        "record_type": {"const": "schedule-snapshot"},
        "contract_version": {"const": "scheduling/v1"},
        "snapshot_id": {"$ref": "#/$defs/id"},
        "state_revision": {"type": "integer", "minimum": 0},
        "ruleset_version": {"$ref": "#/$defs/id"},
        "generated_at": {"$ref": "#/$defs/dateTime"},
        "effective_date": {"$ref": "#/$defs/date"},
        "timezone": {"$ref": "#/$defs/id"},
        "session_minutes": {"type": "integer", "minimum": 1, "maximum": 240},
        "minimum_block_minutes": {"type": "integer", "minimum": 1, "maximum": 60},
        "max_active_items": {"type": "integer", "minimum": 0, "maximum": 20},
        "self_reported_load": {"type": "string", "enum": ["normal", "high"]},
        "high_load_max_minutes": {"type": "integer", "minimum": 1, "maximum": 240},
        "weekly_budget": {"$ref": "#/$defs/weeklyBudget"},
        "goals": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/practiceGoal"}},
        "items": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/workItem"}}
      }
    },
    "selectedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "minutes", "reason_codes", "due_state", "overdue_days"],
      "properties": {
        "item_id": {"$ref": "#/$defs/id"},
        "minutes": {"type": "integer", "minimum": 1, "maximum": 240},
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "due_state": {"type": "string", "enum": ["due", "not-due", "not-applicable"]},
        "overdue_days": {"type": "integer", "minimum": 0}
      }
    },
    "excludedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "reason_codes"],
      "properties": {
        "item_id": {"$ref": "#/$defs/id"},
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "progressionProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "state", "due_state", "overdue_days", "blocked", "paused", "retired", "missed", "plateau_observed"],
      "properties": {
        "item_id": {"$ref": "#/$defs/id"},
        "dimension": {"$ref": "#/$defs/id"},
        "state": {"$ref": "#/$defs/state"},
        "approved_transition_proposal_id": {"$ref": "#/$defs/id"},
        "due_state": {"type": "string", "enum": ["due", "not-due", "not-applicable"]},
        "overdue_days": {"type": "integer", "minimum": 0},
        "blocked": {"type": "boolean"},
        "paused": {"type": "boolean"},
        "retired": {"type": "boolean"},
        "missed": {"type": "boolean"},
        "plateau_observed": {"type": "boolean"},
        "target_realization": {"$ref": "#/$defs/realization"},
        "maintenance_realization": {"$ref": "#/$defs/realization"}
      }
    },
    "goalProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal_id", "item_id", "period", "target_sessions", "completed_sessions", "remaining_sessions", "complete"],
      "properties": {
        "goal_id": {"$ref": "#/$defs/id"},
        "item_id": {"$ref": "#/$defs/id"},
        "period": {"type": "string", "enum": ["weekly", "monthly"]},
        "target_sessions": {"type": "integer", "minimum": 1, "maximum": 1000},
        "completed_sessions": {"type": "integer", "minimum": 0, "maximum": 1000},
        "remaining_sessions": {"type": "integer", "minimum": 0, "maximum": 1000},
        "complete": {"type": "boolean"}
      }
    },
    "projectionReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "contract_version", "projection_id", "snapshot_id", "state_revision", "ruleset_version", "generated_at", "effective_date", "items", "goals"],
      "properties": {
        "record_type": {"const": "progression-projection"},
        "contract_version": {"const": "scheduling/v1"},
        "projection_id": {"$ref": "#/$defs/id"},
        "snapshot_id": {"$ref": "#/$defs/id"},
        "state_revision": {"type": "integer", "minimum": 0},
        "ruleset_version": {"$ref": "#/$defs/id"},
        "generated_at": {"$ref": "#/$defs/dateTime"},
        "effective_date": {"$ref": "#/$defs/date"},
        "items": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/progressionProjection"}},
        "goals": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/goalProjection"}}
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type", "contract_version", "proposal_id", "snapshot_id", "state_revision",
        "ruleset_version", "generated_at", "effective_date", "expires_after_date", "status",
        "selected", "excluded", "conflicts", "requires_approval"
      ],
      "properties": {
        "record_type": {"const": "schedule-proposal"},
        "contract_version": {"const": "scheduling/v1"},
        "proposal_id": {"$ref": "#/$defs/id"},
        "snapshot_id": {"$ref": "#/$defs/id"},
        "state_revision": {"type": "integer", "minimum": 0},
        "ruleset_version": {"$ref": "#/$defs/id"},
        "generated_at": {"$ref": "#/$defs/dateTime"},
        "effective_date": {"$ref": "#/$defs/date"},
        "expires_after_date": {"$ref": "#/$defs/date"},
        "status": {"type": "string", "enum": ["complete", "no-op"]},
        "selected": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/selectedItem"}},
        "excluded": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/excludedItem"}},
        "conflicts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "requires_approval": {"const": true}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "contract_version", "approval_id", "proposal_id", "snapshot_id", "state_revision", "ruleset_version", "approved_at"],
      "properties": {
        "record_type": {"const": "schedule-approval"},
        "contract_version": {"const": "scheduling/v1"},
        "approval_id": {"$ref": "#/$defs/id"},
        "proposal_id": {"$ref": "#/$defs/id"},
        "snapshot_id": {"$ref": "#/$defs/id"},
        "state_revision": {"type": "integer", "minimum": 0},
        "ruleset_version": {"$ref": "#/$defs/id"},
        "approved_at": {"$ref": "#/$defs/dateTime"}
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "contract_version", "completion_id", "proposal_id", "completed_at", "completed_item_ids", "actual_minutes"],
      "properties": {
        "record_type": {"const": "completion-record"},
        "contract_version": {"const": "scheduling/v1"},
        "completion_id": {"$ref": "#/$defs/id"},
        "proposal_id": {"$ref": "#/$defs/id"},
        "completed_at": {"$ref": "#/$defs/dateTime"},
        "completed_item_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "actual_minutes": {"type": "integer", "minimum": 0, "maximum": 1440}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "contract_version", "event_id", "event_type", "occurred_at", "state_revision", "references"],
      "properties": {
        "record_type": {"const": "schedule-event"},
        "contract_version": {"const": "scheduling/v1"},
        "event_id": {"$ref": "#/$defs/id"},
        "event_type": {"type": "string", "enum": ["proposal-created", "proposal-approved", "proposal-rejected", "session-completed", "session-missed", "item-paused", "item-resumed"]},
        "occurred_at": {"$ref": "#/$defs/dateTime"},
        "state_revision": {"type": "integer", "minimum": 0},
        "references": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}
